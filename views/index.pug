doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Threech
        link(rel="stylesheet", href="/style.css")

    body
        header
            a.logo(href="/") Threech

            nav
                button#open-create(type="button") + New post
                button(type="button", onclick="location.href='/'") Home
                button(type="button", onclick="location.href='/auth/login'") Login
                button(type="button", onclick="location.href='/auth/registration'") Registration
        
        dialog#create-dialog
            form(action="/", method="POST")
                h2 New post
                input(type="text", name="title", placeholder="Title", required)
                textarea(name="content", placeholder="What's on your mind?", required)
                .actions
                    button#close-create(type="button") Cancel
                    button(type="submit") Post

        main.container
            h1 Latest Posts
            if error
                p.error= error

            if posts.length
                .posts
                    each post in posts
                        article.post
                            h2= post.title
                            p.author by #{post.author}
                            p= post.content
                            form.delete-form(action=`/${post._id}/delete`, method="POST")
                                button.delete-btn(type="submit") Delete
            else
                p No posts yet.
            
            script.
                const dialog = document.getElementById("create-dialog");
                document.getElementById("open-create").addEventListener("click", () => dialog.showModal());
                document.getElementById("close-create").addEventListener("click", () => dialog.close());

