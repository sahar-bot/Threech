doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Threech
        link(rel="stylesheet", href="/style.css")

    body
        header
            a.logo(href="/") Threech

            nav
                a(href="/") Home
                a(href="/auth/login") Login
                a(href="/auth/registration") Register

        main.container
            h1 Latest Posts

            if posts.length
                .posts
                    each post in posts
                        article.post
                            h2= post.title
                            p.author by #{post.author}
                            p= post.content
            else
                p No posts yet.

