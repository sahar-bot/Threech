doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Login
        link(rel="stylesheet", href="/style.css")

    body
        header
            a.logo(href="/") Threech

            nav
                a(href="/") Home
                a(href="/auth/login") Login
                a(href="/auth/registration") Register

        main.container
            .form-box
                h1 Login
                if error
                    p.error= error
                form(action="/auth/login", method="POST")
                    label(for="username") Username
                    input#username(
                        type="text"
                        name="username"
                        required
                    )

                    label(for="password") Password
                    input#password(
                        type="password"
                        name="password"
                        required
                    )

                    button(type="submit") Login

                p
                    | Don't have an account?
                    a(href="/auth/registration") Register
